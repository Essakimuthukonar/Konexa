@import 'tailwindcss';

@layer base {
  :root {
    color-scheme: dark;
  }

  * {
    @apply border-[hsl(var(--border))];
  }

  body {
    @apply bg-[#050506]  font-sans;
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.25);
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 175, 55, 0.45);
  }
}

@layer components {
  .glass {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    backdrop-filter: blur(16px) saturate(130%);
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    border: 1px solid rgba(212, 175, 55, 0.15);
    box-shadow:
      0 20px 60px -20px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
  }

  .glass-hover {
    @apply transition-all duration-300 cursor-pointer;
  }

  .glass-hover:hover {
    border-color: rgba(212, 175, 55, 0.35);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.9),
      0 0 30px -8px rgba(212, 175, 55, 0.35),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
  }

  .gold-glow {
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  }

  .telemetry-panel {
    @apply glass relative overflow-hidden rounded-lg p-4 sm:p-6;
  }

  .metric-value {
    @apply font-display text-2xl font-bold tracking-wider sm:text-3xl;
  }

  .metric-label {
    @apply text-xs font-mono uppercase tracking-widest text-muted-foreground;
  }

  .sidebar-item {
    @apply relative flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all duration-300;
  }

  .sidebar-item:hover {
    @apply bg-white/5;
  }

  .sidebar-item.active {
    @apply bg-gold-500/10 text-gold-400;
  }

  .sidebar-item.active::before {
    content: '';
    @apply absolute left-0 top-0 bottom-0 w-1 bg-gold-400 rounded-r;
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
